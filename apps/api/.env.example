DATABASE_URL="postgresql://dentista:dentista@localhost:5433/dentista?schema=public"
PORT=3333
# Origens liberadas no CORS. Aceita várias separadas por vírgula e ignora barra
# no final — a Vercel publica o mesmo app em mais de um domínio (alias de
# produção, alias do branch, um por deploy) e cada um é uma origem diferente.
# Ex.: WEB_APP_URL="https://app.vercel.app,https://app-git-main-voce.vercel.app"
WEB_APP_URL="http://localhost:3000"

# Obrigatórios — a API não sobe sem eles (sem fallback de propósito: um
# segredo previsível em produção permite forjar token válido pra qualquer
# clínica/papel). Gere valores aleatórios reais antes de ir a produção, ex.:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET="troque-por-um-valor-aleatorio-de-verdade"
JWT_REFRESH_SECRET="troque-por-outro-valor-aleatorio-diferente-do-de-cima"

# Opcional — monitoramento de erro (sentry.io, tem tier grátis). Sem isso, a
# API funciona normalmente, só não reporta erro nenhum lugar.
SENTRY_DSN=""
